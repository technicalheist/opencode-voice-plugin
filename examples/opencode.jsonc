{
  "$schema": "https://opencode.ai/config.json",
  "plugins": [
    {
      "package": "/absolute/path/to/opencode-voice-plugin",
      "options": {
        "baseUrl": "http://localhost:8880",
        "voice": "af_heart",
        "speed": 1,
        "speakOnIdle": true,
        "speakSubagents": false,
        "debug": false
      }
    }
  ]
}
